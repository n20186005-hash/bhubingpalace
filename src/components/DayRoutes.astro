---
import { getI18n } from '../i18n/ui';
const { messages } = getI18n(Astro.url);
const d = messages.dayRoutes;
const labels = d.labels;
const routes = d.routes ?? [];
---

<section id="day-routes" class="section-padding" style="background: var(--bg-secondary);">
  <div class="max-w-6xl mx-auto px-4">
    <div class="max-w-3xl mx-auto text-center mb-10">
      <h2 class="font-display text-3xl sm:text-4xl font-semibold mb-3" style="color: var(--text-primary);">{d.title}</h2>
      <p class="text-base sm:text-lg leading-relaxed" style="color: var(--text-secondary);">{d.subtitle}</p>
    </div>

    <div class="grid lg:grid-cols-2 gap-6">
      {routes.map((route) => (
        <article class="rounded-3xl p-7 md:p-8 border flex flex-col h-full" style="background: var(--card-bg); border-color: var(--border-color); box-shadow: var(--card-shadow);">
          <div class="flex items-center gap-4 mb-5">
            <div class="w-12 h-12 rounded-2xl flex items-center justify-center text-2xl shrink-0" style="background: color-mix(in srgb, var(--accent) 14%, transparent);">
              <span aria-hidden="true">{route.icon}</span>
            </div>
            <h3 class="font-display text-xl sm:text-2xl font-semibold" style="color: var(--text-primary);">{route.name}</h3>
          </div>

          <div class="rounded-xl px-4 py-3 mb-6 border-l-4" style="background: color-mix(in srgb, var(--accent) 9%, transparent); border-color: var(--accent);">
            <p class="text-sm mb-1" style="color: var(--text-secondary);">
              <span style="color: var(--text-muted);">{labels.duration}: </span>{route.duration}
            </p>
            <p class="text-sm" style="color: var(--text-secondary);">
              <span style="color: var(--text-muted);">{labels.bestFor}: </span>{route.bestFor}
            </p>
          </div>

          <p class="text-xs uppercase tracking-[0.16em] mb-4" style="color: var(--text-muted);">{labels.timeline}</p>
          <ol class="relative space-y-5 mb-6 pl-5" style="border-left: 2px solid var(--border-color);">
            {route.timeline.map((step) => (
              <li class="relative">
                <span class="absolute -left-[27px] top-1.5 w-3 h-3 rounded-full" style="background: var(--accent); box-shadow: 0 0 0 3px var(--card-bg);"></span>
                <div class="flex flex-wrap items-baseline gap-x-3">
                  <time class="text-sm font-semibold tabular-nums" style="color: var(--accent);">{step.time}</time>
                  <span class="font-semibold text-sm" style="color: var(--text-primary);">{step.title}</span>
                </div>
                <p class="text-sm leading-relaxed mt-1" style="color: var(--text-secondary);">{step.text}</p>
              </li>
            ))}
          </ol>

          <ul class="space-y-2.5 text-sm mt-auto pt-5 border-t" style="border-color: var(--border-color); color: var(--text-muted);">
            {route.tips.map((tip) => (
              <li class="flex gap-2.5"><span class="shrink-0" aria-hidden="true">💡</span><span>{tip}</span></li>
            ))}
          </ul>
        </article>
      ))}
    </div>
  </div>
</section>
