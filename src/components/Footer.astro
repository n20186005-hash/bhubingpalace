---
import { getI18n } from '../i18n/ui';
const { lang, messages } = getI18n(Astro.url);
const f = messages.footer;
---
<footer class="section-padding" style="background: var(--bg-tertiary); border-top: 1px solid var(--border-color);">
  <div class="max-w-6xl mx-auto px-4 flex flex-col sm:flex-row sm:items-start sm:justify-between gap-6 text-sm" style="color: var(--text-secondary);">
    <div>
      <p class="font-semibold" style="color: var(--text-primary);">© 2026 {messages.header.siteName}</p>
      <p class="mt-2">{f.disclaimer}</p>
    </div>
    <nav class="flex flex-wrap gap-x-5 gap-y-2" aria-label={f.legalLinksTitle}>
      <a href={`/${lang}/privacy-policy/`}>{f.privacy}</a>
      <a href={`/${lang}/terms-of-service/`}>{f.terms}</a>
      <a href={`/${lang}/cookie-settings/`}>{f.cookies}</a>
    </nav>
  </div>
</footer>
