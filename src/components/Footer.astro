---
import { getI18n } from '../i18n/ui';
const { lang, messages } = getI18n(Astro.url);
const f = messages.footer;
const links = f.officialLinksList;
---

<footer class="section-padding" style="background: var(--bg-tertiary); border-top: 1px solid var(--border-color);">
  <div class="max-w-6xl mx-auto px-4">
    <div class="mission-block mb-10">
      <h3 class="mission-title">🎯 {f.mission.title}</h3>
      <p class="mission-text">{f.mission.text}</p>
    </div>
    {f.entity && (
      <div class="rounded-2xl p-6 md:p-7 border mb-10" style="background: var(--card-bg); border-color: var(--border-color); box-shadow: var(--card-shadow);">
        <h3 class="font-semibold mb-4" style="color: var(--text-primary);">📍 {f.entity.title}</h3>
        <p class="font-display text-lg font-semibold mb-5" style="color: var(--text-primary);">{f.entity.officialName}</p>
        <dl class="grid sm:grid-cols-2 gap-x-8 gap-y-4 text-sm">
          <div class="sm:col-span-2">
            <dt class="text-xs mb-1" style="color: var(--text-muted);">{f.entity.addressLabel}</dt>
            <dd class="leading-relaxed">
              <a href={f.mapsUrl} target="_blank" rel="noopener noreferrer" class="hover:opacity-70" style="color: var(--accent);">{f.entity.addressValue}</a>
            </dd>
          </div>
          <div>
            <dt class="text-xs mb-1" style="color: var(--text-muted);">{f.entity.phoneLabel}</dt>
            <dd>
              <a href="tel:+6653294555" class="hover:opacity-70" style="color: var(--accent);">{f.entity.phoneValue}</a>
            </dd>
          </div>
          <div>
            <dt class="text-xs mb-1" style="color: var(--text-muted);">{f.entity.plusCodeLabel}</dt>
            <dd style="color: var(--text-secondary);">{f.entity.plusCodeValue}</dd>
          </div>
          <div class="sm:col-span-2">
            <dt class="text-xs mb-1" style="color: var(--text-muted);">{f.entity.ratingLabel}</dt>
            <dd style="color: var(--text-secondary);">
              <span class="font-semibold" style="color: var(--text-primary);">★★★★☆ {f.entity.ratingValue}</span>
              <span class="ml-2 text-xs" style="color: var(--text-muted);">{f.entity.ratingSuffix}</span>
            </dd>
          </div>
        </dl>
      </div>
    )}

    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-10">
      <div>
        <h3 class="font-display text-xl font-semibold mb-3" style="color: var(--text-primary);" set:html={f.siteName}></h3>
        <p class="text-sm leading-relaxed" style="color: var(--text-secondary);">{f.rights}</p>
      </div>

      <div>
        <h4 class="font-semibold mb-3" style="color: var(--text-primary);">{f.officialResourcesTitle}</h4>
        <ul class="space-y-2 text-sm">
          {links.map((link) => (
            <li>
              <a href={link.url} target="_blank" rel="noopener noreferrer" class="hover:opacity-70 break-words" style="color: var(--accent);">
                {link.name} ↗
              </a>
            </li>
          ))}
          <li class="pt-2 border-t" style="border-color: var(--border-color);">
            <a href={f.mapsUrl} target="_blank" rel="noopener noreferrer" class="hover:opacity-70 font-medium" style="color: var(--accent);">
              {f.mapsLabel}
            </a>
          </li>
        </ul>
      </div>

      <div>
        <h4 class="font-semibold mb-3" style="color: var(--text-primary);">{f.legalLinksTitle}</h4>
        <ul class="space-y-2 text-sm">
          <li><a href={`/${lang}/privacy-policy/`} class="hover:opacity-70" style="color: var(--text-secondary);">{f.privacy}</a></li>
          <li><a href={`/${lang}/terms-of-service/`} class="hover:opacity-70" style="color: var(--text-secondary);">{f.terms}</a></li>
          <li><a href={`/${lang}/cookie-settings/`} class="hover:opacity-70" style="color: var(--text-secondary);">{f.cookies}</a></li>
        </ul>
      </div>
    </div>

    <div class="mt-10 pt-6 border-t text-xs" style="border-color: var(--border-color); color: var(--text-muted);">
      <div class="mb-3">
        <span class="inline-block px-2 py-1 rounded text-[10px] font-medium tracking-wider" style="background: var(--accent); color: white; opacity: 0.9;">
          非官方独立非营利项目 / UNOFFICIAL INDEPENDENT NON-PROFIT
        </span>
      </div>
      <p class="leading-relaxed" set:html={f.disclaimer}></p>
      {f.dataSourceLabel && f.dataSource && (
        <p class="mt-3 leading-relaxed"><span class="font-medium" style="color: var(--text-secondary);">{f.dataSourceLabel}：</span> <span set:html={f.dataSource}></span></p>
      )}
      {f.imageCopyright && (
        <p class="mt-3 leading-relaxed"><span class="font-medium" style="color: var(--text-secondary);">©</span> {f.imageCopyright}</p>
      )}
    </div>
  </div>
</footer>
