---
import { getI18n } from '../i18n/ui';
const { messages } = getI18n(Astro.url);
const h = messages.historyLegends;
const chapters = h.chapters ?? [];
const legends = h.legends ?? [];
const timeline = h.timeline ?? [];
---

<section id="history-legends" class="section-padding" style="background: var(--bg-secondary);">
  <div class="max-w-6xl mx-auto px-4">
    <div class="max-w-3xl mx-auto text-center mb-12">
      <h2 class="font-display text-3xl sm:text-4xl font-semibold mb-3" style="color: var(--text-primary);">{h.title}</h2>
      <p class="text-base sm:text-lg leading-relaxed" style="color: var(--text-secondary);">{h.subtitle}</p>
    </div>

    <div class="space-y-6">
      {chapters.map((chapter, index) => (
        <article class="rounded-3xl p-7 md:p-9 border" style="background: var(--card-bg); border-color: var(--border-color); box-shadow: var(--card-shadow);">
          <div class="flex flex-wrap items-center gap-3 mb-4">
            <span class="text-xs font-semibold px-3 py-1 rounded-full" style="background: var(--tag-bg); color: var(--tag-text);">{chapter.badge}</span>
            <h3 class="font-display text-xl sm:text-2xl font-semibold" style="color: var(--text-primary);">{chapter.title}</h3>
          </div>
          <p class="text-sm sm:text-base leading-relaxed" style="color: var(--text-secondary);">{chapter.text}</p>
        </article>
      ))}
    </div>

    <div class="mt-10 grid lg:grid-cols-[1.1fr_1fr] gap-6">
      <div class="rounded-3xl p-7 border h-full" style="background: var(--bg-tertiary); border-color: var(--border-color);">
        <h3 class="font-semibold text-xl mb-5" style="color: var(--text-primary);">📖 {h.legendTitle}</h3>
        <div class="space-y-5">
          {legends.map((legend) => (
            <div class="border-l-2 pl-4" style="border-color: var(--accent);">
              <h4 class="font-semibold text-base mb-1.5" style="color: var(--text-primary);">{legend.title}</h4>
              <p class="text-sm leading-relaxed" style="color: var(--text-secondary);">{legend.text}</p>
            </div>
          ))}
        </div>
      </div>

      <div class="rounded-3xl p-7 border h-full" style="background: var(--card-bg); border-color: var(--border-color); box-shadow: var(--card-shadow);">
        <h3 class="font-semibold text-xl mb-5" style="color: var(--text-primary);">🗓️ {h.timelineTitle}</h3>
        <ol class="relative space-y-5 pl-5" style="border-left: 2px solid var(--border-color);">
          {timeline.map((entry) => (
            <li class="relative">
              <span class="absolute -left-[27px] top-1.5 w-3 h-3 rounded-full" style="background: var(--accent); box-shadow: 0 0 0 3px var(--card-bg);"></span>
              <p class="text-sm font-semibold mb-0.5" style="color: var(--accent);">{entry.year}</p>
              <p class="text-sm leading-relaxed" style="color: var(--text-secondary);">{entry.text}</p>
            </li>
          ))}
        </ol>
      </div>
    </div>

    <p class="text-xs mt-6 leading-relaxed" style="color: var(--text-muted);">{h.caveat}</p>
  </div>
</section>
