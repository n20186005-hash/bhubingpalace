---
import { getI18n } from '../i18n/ui';
const { messages } = getI18n(Astro.url);
const r = messages.reviews;
const h = messages.hero;
---

<section id="reviews" class="section-padding" style="background: var(--bg-primary);">
  <div class="max-w-4xl mx-auto px-4">
    <h2 class="font-display text-3xl sm:text-4xl font-semibold mb-3 text-center" style="color: var(--text-primary);">{r.title}</h2>
    <p class="text-center text-base mb-8" style="color: var(--text-secondary);">{r.declaration}</p>

    <div class="rounded-2xl p-8 border text-center max-w-xl mx-auto" style="background: var(--card-bg); border-color: var(--border-color); box-shadow: var(--card-shadow);">
      <div class="text-4xl font-bold mb-1" style="color: var(--accent);">{h.rating}</div>
      <div class="text-base" style="color: var(--text-secondary);">{h.reviewCount}</div>
      <div class="flex justify-center gap-0.5 text-2xl my-3" style="color: var(--accent);" aria-label="5 out of 5">★★★★★</div>
      <a
        href={r.mapsUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex mt-2 px-8 py-3 rounded-full font-semibold text-white"
        style="background: var(--accent);"
      >
        📍 {r.moreReviews}
      </a>
    </div>

    {r.sourceDisclaimer && (
      <p class="text-center text-xs mt-6 max-w-2xl mx-auto leading-relaxed" style="color: var(--text-muted);">{r.sourceDisclaimer}</p>
    )}
  </div>
</section>
