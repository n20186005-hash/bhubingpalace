{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bhubingpalace",
  "main": "dist/_worker.js/index.js",
  "compatibility_date": "2025-05-21",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "none"
  },
  "observability": {
    "enabled": true
  },
  "routes": [
    {
      "pattern": "bhubingpalace.com",
      "custom_domain": true
    }
  ]
}
